<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Esquema propio para que el navegador externo pueda devolver
                 el control a la app después del login con Google. El login
                 en sí ya se abre bien en el navegador del sistema (Capacitor
                 manda ahí cualquier navegación fuera del dominio propio),
                 pero sin esto Supabase no tiene a dónde redirigir de vuelta
                 una vez que Google confirma — se quedaba tildado en el
                 navegador. Ver signInWithGoogle en src/lib/auth.tsx. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="net.livenest.app" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Mantiene la app con prioridad de "foreground" (conexión +
             lectura por voz activas) con la pantalla apagada o la app
             minimizada — ver LiveNestForegroundService.java y
             BackgroundServicePlugin.java. foregroundServiceType tiene que
             coincidir con el que pasa startForeground() en el código, o
             Android tira una excepción al arrancar el servicio. -->
        <service
            android:name=".LiveNestForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Evita que el sistema apague la pantalla mientras la app está
         conectada y leyendo el chat (ver @capacitor-community/keep-awake). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Permite que LiveNest abra el instalador de paquetes para el APK de
         actualización que ella misma descargó (ver ApkUpdaterPlugin.java).
         Sin esto, Android bloquea install() aunque el usuario ya haya
         activado "instalar apps desconocidas" para la app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Necesarios para que LiveNest pueda seguir conectada y leyendo el
         chat con la app minimizada o la pantalla apagada (ver
         LiveNestForegroundService.java) — sin esto Android mata el
         WebSocket/la lectura por voz segundos después de salir de la app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Para que se vea el aviso de "LiveNest sigue conectada" (obligatorio
         pedirlo en tiempo de ejecución desde Android 13 para CUALQUIER
         notificación, no solo esta) — ver BackgroundServicePlugin.java. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
